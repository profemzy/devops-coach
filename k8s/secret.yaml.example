apiVersion: v1
kind: Secret
metadata:
  name: devops-coach-secrets
  namespace: devops-coach
type: Opaque
data:
  # Base64 encoded values
  # To encode: echo -n "your-value" | base64
  # To decode: echo "encoded-value" | base64 -d
  
  OPENAI_API_BASE: <base64-encoded-openai-api-base>
  OPENAI_API_KEY: <base64-encoded-openai-api-key>
  OPENAI_MODEL: <base64-encoded-openai-model>
  POSTGRES_DB: <base64-encoded-postgres-db>
  POSTGRES_HOST: <base64-encoded-postgres-host>
  POSTGRES_PASSWORD: <base64-encoded-postgres-password>
  POSTGRES_PORT: <base64-encoded-postgres-port>
  POSTGRES_USER: <base64-encoded-postgres-user>
  REDIS_URL: <base64-encoded-redis-url>
  SECRET_KEY: <base64-encoded-secret-key>
  TAVILY_API_KEY: <base64-encoded-tavily-api-key>
